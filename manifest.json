{
  "manifest_version": 3,
  "name": "Occasion Radar — by Born To Banger",
  "version": "1.5.0",
  "description": "Tracks birthdays, anniversaries, festivals & public holidays for your country (or all), and suggests party activities in time.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://www.borntobanger.in/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "options.html"
}
